      "minimatch@>=8 <9": "8.0.6",
      "minimatch@>=9 <10": "9.0.7",
      "multer@<2.2.0": "2.2.0",
      "node-forge@<1.4.0": "1.4.0",
      "path-to-regexp@<0.1.13": "0.1.13",
      "picomatch@<3": "2.3.2",
