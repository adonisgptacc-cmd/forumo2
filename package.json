{
  "name": "forumo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:backend": "turbo run dev --filter=backend",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "dev:admin": "turbo run dev --filter=@forumo/admin",
    "postinstall": "pnpm --filter backend prisma:generate",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:migrate": "turbo run migrate --filter=backend",
    "db:seed": "turbo run seed --filter=backend",
    "db:studio": "turbo run studio --filter=backend",
    "setup:cxpak": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-cxpak.ps1",
    "cxpak:overview": ".tools/cxpak/cxpak.exe overview .",
    "cxpak:onboard": ".tools/cxpak/cxpak.exe onboard .",
    "cxpak:visual": ".tools/cxpak/cxpak.exe visual --visual-type dashboard .",
    "cxpak:mcp": ".tools/cxpak/cxpak.exe serve --mcp .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:deployment": "node --test tests/deployment-config.test.mjs",
    "test:dependency-security": "node --test tests/dependency-security.test.mjs",
    "test:hygiene": "node --test tests/repository-hygiene.test.mjs",
    "test:ai-config": "node --test tests/ai-governance.test.mjs",
    "test:prisma-drift": "node --test tests/prisma-drift.test.mjs",
    "test:coverage": "turbo run test --coverage",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint --fix",
    "format": "prettier --write apps packages docs scripts tests \"*.json\" \"*.md\"",
    "format:check": "prettier --check apps packages docs scripts tests \"*.json\" \"*.md\"",
    "build": "turbo run build",
    "verify:quick": "pnpm format:check && pnpm lint && pnpm typecheck",
    "verify": "pnpm test:hygiene && pnpm test:dependency-security && pnpm verify:quick && pnpm test:ai-config && pnpm test:prisma-drift && pnpm test && pnpm test:deployment && pnpm build",
    "clean": "turbo run clean && rm -rf node_modules",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.9.7"
  }
}
