{
  "name": "forumo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.1.4",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:backend": "turbo run dev --filter=backend",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "dev:admin": "turbo run dev --filter=@forumo/admin",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:migrate": "turbo run migrate --filter=backend",
    "db:seed": "turbo run seed --filter=backend",
    "db:studio": "turbo run studio --filter=backend",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:deployment": "node --test tests/deployment-config.test.mjs",
    "test:coverage": "turbo run test --coverage",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.9.14"
  },
  "pnpm": {
    "overrides": {
      "@auth/core@<0.41.3": "0.41.3",
      "@babel/core@<7.29.6": "7.29.6",
      "@babel/plugin-transform-modules-systemjs@<=7.29.3": "7.29.7",
      "@grpc/grpc-js@>=1.14.0 <1.14.4": "1.14.4",
      "@opentelemetry/core@<2.8.0": "2.8.0",
      "@opentelemetry/propagator-jaeger@<2.9.0": "2.9.0",
      "@tootallnate/once@<2.0.1": "2.0.1",
      "@xmldom/xmldom@<0.8.13": "0.8.13",
      "ajv@>=6 <6.14.0": "6.14.0",
      "ajv@>=8 <9": "8.20.0",
      "axios@>=1 <1.18.0": "1.18.0",
      "body-parser@<1.20.6": "1.20.6",
      "body-parser@>=2 <2.3.0": "2.3.0",
      "brace-expansion@<5.0.8": "5.0.9",
      "diff@>=4 <4.0.4": "4.0.4",
      "@hono/node-server@<2.0.10": "2.0.10",
      "engine.io@>=4.1.0 <6.6.9": "6.6.9",
      "fast-uri@>=3 <3.1.5": "3.1.5",
      "fast-xml-parser@>=4 <5": "4.5.5",
      "fast-xml-parser@>=5 <5.10.1": "5.10.1",
      "file-type@>=20 <21.3.2": "21.3.2",
      "flatted@<3.4.4": "3.4.4",
      "form-data@>=3 <4": "3.0.5",
      "form-data@>=4 <5": "4.0.6",
      "handlebars@4.7.8": "4.7.9",
      "hono@<4.12.34": "4.12.34",
      "ip-address@<10.3.1": "10.3.1",
      "joi@<17.13.4": "17.13.4",
      "js-yaml@>=3 <4": "3.15.0",
      "js-yaml@>=4 <5": "4.3.0",
      "jws@<3.2.3": "3.2.3",
      "lodash@>=4 <4.18.0": "4.18.0",
      "minimatch@<3.1.4": "3.1.4",
