# Database
DATABASE_URL=postgresql://forumo:forumo@localhost:5432/forumo?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=3600

# Storage (MinIO / S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
UPLOADS_BUCKET=forumo-uploads

# Auth — REQUIRED
JWT_SECRET=changeme-generate-secure-secret
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# CORS / URLs
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Stripe — REQUIRED for USD/EUR/GBP payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Paystack — REQUIRED for NGN/GHS/KES/ZAR payments (African markets)
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_WEBHOOK_SECRET=

# Email (Mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_EMAIL_FROM=noreply@forumo.app
MAILGUN_API_BASE=https://api.mailgun.net

# SMS (AWS SNS)
SNS_REGION=
SNS_ACCESS_KEY_ID=
SNS_SECRET_ACCESS_KEY=
SNS_SMS_SENDER_ID=Forumo

# Admin notifications
ADMIN_NOTIFICATION_EMAIL=admin@forumo.app

# SMTP (local dev mailpit — not used when Mailgun is configured)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@app.local

# Moderation service
MODERATION_SERVICE_URL=http://localhost:5005

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=forumo-backend
LOG_LEVEL=debug
METRICS_API_KEY=
SENTRY_DSN=

# Server
PORT=4000
NODE_ENV=development
