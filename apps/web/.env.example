# Site URL (used for sitemap and OG tags in production)
NEXT_PUBLIC_SITE_URL=https://forumo.africa

# API
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# NextAuth — REQUIRED in production (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=changeme-generate-a-real-secret
NEXTAUTH_URL=http://localhost:3000

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Feature flags
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_USE_API_MOCKS=false

# Observability
NEXT_PUBLIC_SENTRY_DSN=
ANALYZE_BUNDLE=false
