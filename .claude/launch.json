{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev:web"],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev:backend"],
      "port": 4000
    },
    {
      "name": "mobile",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev:mobile"],
      "port": 8081
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev:admin"],
      "port": 3001
    },
    {
      "name": "prisma-studio",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "backend", "run", "studio"],
      "port": 5555
    }
  ]
}
