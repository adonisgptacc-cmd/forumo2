# Forumo Staging Environment Variables Template
# Copy this file to .env.staging and fill in the actual values
# DO NOT commit .env.staging to version control

# Database
POSTGRES_PASSWORD_STAGING=your_secure_postgres_password_here

# Redis
REDIS_PASSWORD_STAGING=your_secure_redis_password_here

# JWT
JWT_SECRET_STAGING=your_jwt_secret_at_least_32_characters_here

# Stripe
STRIPE_SECRET_KEY_STAGING=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_STAGING=pk_test_your_stripe_publishable_key

# Paystack
PAYSTACK_SECRET_KEY_STAGING=sk_test_your_paystack_secret_key

# Shippo
SHIPPO_API_KEY_STAGING=your_shippo_api_key

# Mailgun
MAILGUN_API_KEY_STAGING=your_mailgun_api_key

# AWS SNS
SNS_ACCESS_KEY_ID_STAGING=your_sns_access_key_id
SNS_SECRET_ACCESS_KEY_STAGING=your_sns_secret_access_key

# MinIO
MINIO_ROOT_USER_STAGING=minioadmin_staging
MINIO_ROOT_PASSWORD_STAGING=your_secure_minio_password_here

# Moderation Service
MODERATION_INTERNAL_TOKEN_STAGING=your_secure_moderation_token_here

# NextAuth
NEXTAUTH_SECRET_STAGING=your_nextauth_secret_at_least_32_characters_here
NEXTAUTH_URL_STAGING=https://staging.forumo.example.com

# Public API URL
NEXT_PUBLIC_API_BASE_URL_STAGING=https://staging-api.forumo.example.com/api/v1