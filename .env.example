# ─── Backend: Database & Cache ────────────────────────────────────────────────
# PostgreSQL connection string (replace user/password/host for production)
DATABASE_URL=postgresql://forumo:forumo@localhost:5432/forumo
# Redis connection string (used for sessions, OTP rate-limiting, BullMQ)
REDIS_URL=redis://localhost:6379

# ─── Backend: Auth ────────────────────────────────────────────────────────────
# Secret used to sign JWTs — generate with: openssl rand -hex 32
JWT_SECRET=super-secret
# Access token TTL in seconds (15 min = 900, 24 h = 86400)
JWT_TTL=900
# OTP one-time-password settings
OTP_TTL=300
OTP_DEVICE_RATE_LIMIT=5
OTP_DEVICE_RATE_WINDOW=300

# ─── Backend: Rate limits ─────────────────────────────────────────────────────
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_MS=60000
LOGIN_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_WINDOW_MS=900000
RESEND_RATE_LIMIT=3
RESEND_RATE_WINDOW_MS=3600000
PAYMENT_RATE_LIMIT=30
PAYMENT_RATE_WINDOW_MS=60000
CACHE_TTL_SECONDS=30

# ─── Backend: Stripe (https://dashboard.stripe.com/apikeys) ───────────────────
# Backend secret key — never expose this to the browser
STRIPE_SECRET_KEY=sk_test_example
# Webhook signing secret from Stripe dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_example
# Connect webhook signing secret (for seller payout events)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_connect_example

# ─── Backend: Paystack (https://dashboard.paystack.com/#/settings/developer) ──
# Secret key for Paystack API calls and webhook HMAC verification
PAYSTACK_SECRET_KEY=sk_test_example_paystack

# ─── Backend: MinIO / S3 object storage ───────────────────────────────────────
# MinIO host — use localhost:9000 for local dev via docker-compose
MINIO_ENDPOINT=localhost
# MinIO port (9000 = API, 9001 = console)
MINIO_PORT=9000
# Set to "true" for HTTPS endpoints (false for local MinIO)
MINIO_USE_SSL=false
# Access key (username) — see docker-compose.yml for local default
MINIO_ACCESS_KEY=minioadmin
# Secret key (password) — see docker-compose.yml for local default
MINIO_SECRET_KEY=minioadmin
# S3 bucket name for user uploads
UPLOADS_BUCKET=forumo-uploads

# ─── Backend: Moderation service ──────────────────────────────────────────────
# URL of the FastAPI moderation microservice (starts with docker-compose)
MODERATION_SERVICE_URL=http://localhost:5005
# HTTP timeout for moderation calls (ms)
MODERATION_SERVICE_TIMEOUT_MS=5000
# Retry count on moderation service error
MODERATION_MAX_ATTEMPTS=3

# ─── Backend: URLs ────────────────────────────────────────────────────────────
# Allowed CORS origins (comma-separated in production; space OK locally)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Frontend URL used in email links and payment callbacks
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ─── Backend: TOS ─────────────────────────────────────────────────────────────
# TOS version string — must match NEXT_PUBLIC_TOS_VERSION in the frontend
TOS_VERSION=2024-01-01

# ─── Backend: Server ──────────────────────────────────────────────────────────
# Node environment (development | production | test)
NODE_ENV=development
# Backend HTTP port
PORT=4000
# Pino log level (trace | debug | info | warn | error)
LOG_LEVEL=info
# Escrow auto-release delay after delivery confirmed
ESCROW_AUTO_RELEASE_DAYS=5

# ─── Backend: Google OAuth (optional — omit to disable Google sign-in) ────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ─── Backend: Mailgun email (leave unset to use the Mailpit dev simulator) ────
# API key from https://app.mailgun.com/mg/dashboard
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.forumo.dev
MAILGUN_EMAIL_FROM=no-reply@forumo.dev
# Uncomment for EU region accounts
# MAILGUN_API_BASE=https://api.eu.mailgun.net

# ─── Backend: AWS SNS SMS (leave unset to use the dev simulator) ──────────────
SNS_REGION=us-east-1
SNS_ACCESS_KEY_ID=your-sns-access-key
SNS_SECRET_ACCESS_KEY=your-sns-secret
SNS_SMS_SENDER_ID=FORUMO

# ─── Backend: Shippo shipping (https://goshippo.com) ──────────────────────────
SHIPPO_API_KEY=shippo_test_your_api_key_here
# Webhook secret configured in Shippo dashboard → Webhooks
SHIPPO_WEBHOOK_SECRET=your-shippo-webhook-secret

# ─── Backend: Observability (optional) ────────────────────────────────────────
# Sentry DSN for backend error tracking (https://sentry.io)
SENTRY_DSN=
# Token to protect the /metrics Prometheus endpoint
METRICS_TOKEN=
# OpenTelemetry OTLP exporter endpoint (leave empty to use console exporter)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=forumo-backend

# ─── Backend: Seed data ────────────────────────────────────────────────────────
# Initial admin account created by prisma/seed.ts
ADMIN_EMAIL=admin@forumo.dev
ADMIN_PASSWORD=changeme

# ─── Frontend: Next.js / NextAuth ─────────────────────────────────────────────
# Random secret for NextAuth JWT signing — generate with: openssl rand -hex 32
NEXTAUTH_SECRET=replace-me
# Canonical URL of the web app (NextAuth uses this for OAuth callbacks)
NEXTAUTH_URL=http://localhost:3000
# Backend API base URL consumed by the Next.js app
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# WebSocket server URL for real-time messaging
NEXT_PUBLIC_WS_URL=http://localhost:4000
# Stripe publishable key — safe to expose to the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_example
# Set to "true" in development to enable mock auth fallback (never in production)
NEXT_PUBLIC_USE_API_MOCKS=false
# Must match backend TOS_VERSION — triggers re-acceptance modal when bumped
NEXT_PUBLIC_TOS_VERSION=2024-01-01
# Sentry DSN for frontend error tracking (optional — omit to disable)
NEXT_PUBLIC_SENTRY_DSN=
# App environment label surfaced to Sentry and analytics
NEXT_PUBLIC_ENVIRONMENT=development
